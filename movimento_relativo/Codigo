from vpython import *
#Web VPython 3.2
# 1. Configuração da Cena 3D
scene = canvas(
    title="<b>Simulador Cinemático: Movimento Relativo e Inércia</b>",
    width=700,
    height=500,
    align="left",
    background=color.cyan
)
scene.center = vector(0, 10, 0)
scene.range = 100

# 2. Configuração Opcional do Gráfico
# O gráfico começa desligado e pode ser ativado pelo menu.
g_posicao = None
curva_x_trem = None
curva_x_pessoa = None
historico = []


def criar_grafico():
    """Cria o gráfico e plota os pontos acumulados até o momento."""
    global g_posicao, curva_x_trem, curva_x_pessoa

    if g_posicao is not None:
        return

    g_posicao = graph(
        title="Posição no Solo (x x t)",
        xtitle="Tempo t (s)",
        ytitle="Posição x (m)",
        width=400,
        height=300,
        align="right",
        xmin=0,
        xmax=15,
        ymin=-200,
        ymax=250
    )

    curva_x_trem = gcurve(
        graph=g_posicao,
        color=color.blue,
        width=3,
        label="Trem"
    )
    curva_x_pessoa = gcurve(
        graph=g_posicao,
        color=color.red,
        width=3,
        label="Pessoa"
    )

    for ponto in historico:
        curva_x_trem.plot(ponto[0], ponto[1])
        curva_x_pessoa.plot(ponto[0], ponto[2])


def remover_grafico():
    """Remove o gráfico da cena sem apagar o histórico da simulação."""
    global g_posicao, curva_x_trem, curva_x_pessoa

    if g_posicao is not None:
        g_posicao.delete()

    g_posicao = None
    curva_x_trem = None
    curva_x_pessoa = None


# 3. Objetos do Cenário (Fixos no Solo)
chao = box(
    pos=vector(0, -2, 0),
    size=vector(500, 2, 20),
    color=vector(0.3, 0.7, 0.3)
)
trilho = box(
    pos=vector(0, -0.9, 0),
    size=vector(500, 0.2, 4),
    color=color.gray(0.5)
)

postes = []
for x in range(-200, 201, 30):
    postes.append(
        box(
            pos=vector(x, 5, -10),
            size=vector(0.5, 14, 0.5),
            color=color.orange
        )
    )

# 4. Entidades Móveis
trem = box(
    pos=vector(-80, 2, 0),
    size=vector(140, 6, 8),
    color=color.blue,
    opacity=0.8
)
pessoa = sphere(pos=vector(-80, 6, 0), radius=1.5, color=color.red)

# Vetores de Velocidade
seta_vtrem = arrow(
    pos=trem.pos,
    axis=vector(0, 0, 0),
    color=color.black,
    shaftwidth=0.6,
    headwidth=1.5
)
seta_vpessoa = arrow(
    pos=pessoa.pos,
    axis=vector(0, 0, 0),
    color=color.red,
    shaftwidth=0.6,
    headwidth=1.5
)

# 5. Variáveis de Física e Estado
rodando = False
dt = 0.02
t = 0
v_trem = 20
v_pessoa_relativa = -20
x_inicial = -80

caiu = False
# Velocidade horizontal da pessoa em relação ao solo no instante da saída.
# Depois da saída, essa velocidade fica constante (solo sem atrito).
v_pessoa_solo_constante = 0
v_pessoa_relativa_saida = 0

# 6. Interface de Usuário (UI)
scene.append_to_caption('\n<b>Painel de Controle</b>\n\n')


def altera_vpessoa(s):
    global v_pessoa_relativa
    v_pessoa_relativa = s.value
    texto_vp.text = f" {v_pessoa_relativa} m/s"
    if caiu:
        velocidade_solo = v_pessoa_solo_constante
    else:
        velocidade_solo = v_trem + v_pessoa_relativa
    texto_vp_solo.text = f" {round(velocidade_solo, 1)} m/s"


scene.append_to_caption(
    '<b>Velocidade da pessoa em relação ao trem (ajustada no slider):</b> '
)
sl_vp = slider(
    min=-50,
    max=50,
    value=-20,
    step=1,
    length=250,
    bind=altera_vpessoa
)
texto_vp = wtext(text=" -20 m/s")
scene.append_to_caption(
    '<br><b>Velocidade da pessoa em relação ao solo (resultado):</b> '
)
texto_vp_solo = wtext(text=" 0 m/s")
scene.append_to_caption(
    '<br><span style="color:#475569; font-size:12px;">'
    'V pessoa/solo = V trem + V pessoa/trem. Após a saída, '
    'V pessoa/solo é conservada por inércia (sem atrito).</span>\n\n'
)

modo_referencial = "Observador no Solo (Externo)"


def altera_referencial(m):
    global modo_referencial
    modo_referencial = m.selected


scene.append_to_caption('<b>Referencial de Observação: </b>')
menu(
    choices=[
        "Observador no Solo (Externo)",
        "Observador no Trem (Interno)"
    ],
    bind=altera_referencial
)
scene.append_to_caption('\n\n')


def altera_visualizacao(m):
    if m.selected == "Movimento + Gráfico":
        criar_grafico()
    else:
        remover_grafico()


scene.append_to_caption('<b>Visualização: </b>')
menu(
    choices=["Somente Movimento", "Movimento + Gráfico"],
    selected="Somente Movimento",
    bind=altera_visualizacao
)
scene.append_to_caption('\n\n')

problem_statement_visivel = False
texto_problem_statement = wtext(text="")

