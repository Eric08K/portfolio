def alterna_problem_statement(b):
    global problem_statement_visivel
    problem_statement_visivel = not problem_statement_visivel

    if problem_statement_visivel:
        texto_problem_statement.text = PROBLEM_STATEMENT
        b.text = "Ocultar Problem Statement"
    else:
        texto_problem_statement.text = ""
        b.text = "Mostrar Problem Statement"


button(text="Mostrar Problem Statement", bind=alterna_problem_statement)
scene.append_to_caption('\n\n')


def play_pause(b):
    global rodando
    rodando = not rodando
    b.text = "<b>⏸ Pausar</b>" if rodando else "<b>▶ Iniciar</b>"


def resetar(b):
    global rodando, caiu, v_pessoa_solo_constante
    global v_pessoa_relativa_saida, t
    rodando = False
    caiu = False
    v_pessoa_solo_constante = 0
    v_pessoa_relativa_saida = 0
    t = 0
    historico.clear()
    texto_vp_solo.text = f" {round(v_trem + v_pessoa_relativa, 1)} m/s"

    if g_posicao is not None:
        curva_x_trem.data = []
        curva_x_pessoa.data = []

    btn_play.text = "<b>▶ Iniciar</b>"
    trem.pos.x = x_inicial
    pessoa.pos.x = x_inicial
    pessoa.pos.y = 6
    scene.center = vector(0, 10, 0)


btn_play = button(
    text="<b>▶ Iniciar</b>",
    bind=play_pause,
    color=color.white,
    background=color.blue
)
scene.append_to_caption('  ')
button(
    text="<b>⟲ Resetar</b>",
    bind=resetar,
    color=color.black,
    background=color.orange
)

label_ref = label(
    pos=vector(0, 38, 0),
    text="",
    box=False,
    color=color.black,
    height=18,
    font="sans"
)

# 7. Loop Principal
while True:
    rate(60)

    # Velocidade da pessoa em relação ao solo enquanto está no trem.
    # Esta velocidade é capturada no instante em que ela sai do trem.
    v_pessoa_solo = v_trem + v_pessoa_relativa

    if rodando:
        t += dt
        trem.pos.x += v_trem * dt

        if not caiu:
            # Calcula o próximo passo e verifica se a pessoa ultrapassa
            # uma das extremidades do trem (comprimento total = 140 m).
            proxima_x_pessoa = pessoa.pos.x + v_pessoa_solo * dt
            separacao_prevista = proxima_x_pessoa - trem.pos.x

            pessoa.pos.x = proxima_x_pessoa

            if abs(separacao_prevista) <= 70:
                pessoa.pos.y = 6
            else:
                # Captura a velocidade no solo no instante da saída.
                # Depois da queda, ela não é recalculada nem desacelerada:
                # o chão sem atrito mantém esta velocidade constante.
                caiu = True
                v_pessoa_solo_constante = v_pessoa_relativa
                v_pessoa_relativa_saida = v_pessoa_relativa
                pessoa.pos.y = -0.5
        else:
            # Chão sem atrito: velocidade horizontal constante.
            pessoa.pos.x += v_pessoa_solo_constante * dt
            pessoa.pos.y = -0.5

        # Registra a história mesmo quando o gráfico não está sendo exibido.
        historico.append((t, trem.pos.x, pessoa.pos.x))

        if g_posicao is not None:
            curva_x_trem.plot(t, trem.pos.x)
            curva_x_pessoa.plot(t, pessoa.pos.x)

    # 8. Câmera e Vetores
    if modo_referencial == "Observador no Solo (Externo)":
        # Depois da saída, acompanha a pessoa para que seu movimento
        # continue visível mesmo quando ela se afasta do trem.
        if caiu:
            scene.center = pessoa.pos + vector(0, 10, 0)
        else:
            scene.center = vector(0, 10, 0)

        scene.range = 100
        label_ref.pos = scene.center + vector(0, 28, 0)

        seta_vtrem.pos = trem.pos + vector(0, 4, 0)
        seta_vtrem.axis = vector(v_trem * 0.4, 0, 0)
        seta_vtrem.visible = True

        seta_vpessoa.pos = pessoa.pos + vector(0, 2.5, 0)

        if caiu:
            velocidade_mostrada = v_pessoa_solo_constante
            seta_vpessoa.axis = vector(velocidade_mostrada * 0.4, 0, 0)
            status_pessoa = (
                "APÓS A QUEDA — SEM ATRITO\n"
                "V pessoa/trem no instante da saída = "
                + str(round(v_pessoa_relativa_saida, 1))
                + " m/s\nV pessoa/solo conservada por inércia = "
                + str(round(velocidade_mostrada, 1))
                + " m/s"
            )
        else:
            velocidade_mostrada = v_pessoa_solo
            seta_vpessoa.axis = vector(velocidade_mostrada * 0.4, 0, 0)
            status_pessoa = (
                "V pessoa/trem (ajuste do slider) = "
                + str(round(v_pessoa_relativa, 1))
                + " m/s\nV pessoa/solo (soma das velocidades) = "
                + str(round(velocidade_mostrada, 1))
                + " m/s"
            )

        label_ref.text = (
            "REFERENCIAL: SOLO\nVelocidade do Trem: "
            + str(v_trem)
            + " m/s\n"
            + status_pessoa
        )

    elif modo_referencial == "Observador no Trem (Interno)":
        scene.center = trem.pos + vector(0, 10, 0)
        scene.range = 70
        label_ref.pos = trem.pos + vector(0, 30, 0)

        seta_vtrem.visible = False
        seta_vpessoa.pos = pessoa.pos + vector(0, 2.5, 0)

        if caiu:
            v_relativa_chao = v_pessoa_solo_constante - v_trem
            seta_vpessoa.axis = vector(v_relativa_chao * 0.4, 0, 0)
            status_pessoa = (
                "APÓS A QUEDA — SEM ATRITO\n"
                "V pessoa/solo conservada por inércia = "
                + str(round(v_pessoa_solo_constante, 1))
                + " m/s\nV pessoa/trem (relativa ao trem) = "
                + str(round(v_relativa_chao, 1))
                + " m/s"
            )
        else:
            seta_vpessoa.axis = vector(v_pessoa_relativa * 0.4, 0, 0)
            status_pessoa = (
                "V pessoa/trem (ajuste do slider) = "
                + str(v_pessoa_relativa)
                + " m/s\nV pessoa/solo (soma das velocidades) = "
                + str(round(v_pessoa_solo, 1))
                + " m/s"
            )

        label_ref.text = (
            "REFERENCIAL: TREM\nVelocidade do Trem: 0 m/s "
            "(em repouso relativo)\n"
            + status_pessoa
        )
